  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action on a card or dialog.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>Add child</button>",
      "css": ".ds-btn{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 18px;border-radius:12px;font-weight:600;font-size:14.5px;border:0;cursor:pointer;transition:background .15s,border-color .15s}.ds-btn svg{flex:none}.ds-btn:focus-visible{outline:2px solid #2498F3;outline-offset:2px}.ds-btn-primary{background:#1673C4;color:#fff}.ds-btn-primary:hover{background:#0F63AC}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Alternative actions next to a primary, and toggles like Table/Chart.",
      "html": "<button class=\"ds-btn2\">Cancel</button>",
      "css": ".ds-btn2{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 18px;border-radius:12px;font-weight:600;font-size:14.5px;background:#fff;border:1px solid #CCDDEF;color:#0B2348;cursor:pointer;transition:background .15s}.ds-btn2:hover{background:#F3F8FE}.ds-btn2:focus-visible{outline:2px solid #2498F3;outline-offset:2px}"
    },
    {
      "name": "Link Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "\"View all\" and inline navigation in card heads.",
      "html": "<a class=\"ds-link\" href=\"#\">View all <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a>",
      "css": ".ds-link{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:4px;color:#1570C0;font-weight:600;font-size:14px;min-height:32px;text-decoration:none;border-radius:8px}.ds-link svg{width:16px;height:16px}.ds-link:hover{text-decoration:underline;text-underline-offset:3px}.ds-link:focus-visible{outline:2px solid #2498F3;outline-offset:2px}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "pill-ok",
      "description": "Soft fill plus ink, with an icon: the only way status is shown.",
      "html": "<div class=\"ds-pills\"><span class=\"ds-pill ds-ok\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></svg>Protected</span><span class=\"ds-pill ds-warn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg>Needs attention</span><span class=\"ds-pill ds-crit\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg>Action required</span><span class=\"ds-pill ds-muted\">Offline</span></div>",
      "css": ".ds-pills{display:flex;gap:8px;flex-wrap:wrap}.ds-pill{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:13px;font-size:12.5px;font-weight:600;white-space:nowrap}.ds-pill svg{width:14px;height:14px}.ds-ok{background:#E4F6EC;color:#0F7F43}.ds-warn{background:#FEF3E0;color:#94580A}.ds-crit{background:#FDEBEA;color:#B92E2A}.ds-muted{background:#EEF2F7;color:#5A6E91}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled field; focus turns the border sky blue with a soft halo.",
      "html": "<label class=\"ds-field\"><span>Child's name</span><input class=\"ds-input\" placeholder=\"e.g. Lucas\"></label>",
      "css": ".ds-field{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;display:flex;flex-direction:column;gap:6px;max-width:320px}.ds-field span{font-size:13px;font-weight:600;color:#34496A}.ds-input{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;height:44px;padding:0 12px;border-radius:10px;border:1px solid #CCDDEF;background:#fff;color:#0B2348;font-size:15px;outline:none;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:#5A6E91}.ds-input:focus{border-color:#2498F3;box-shadow:0 0 0 4px #E7F4FF}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "44px items; active is a sky wash with a 3px accent bar on the left edge.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" aria-current=\"page\" href=\"#\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Dashboard</a><a class=\"ds-nav-item\" href=\"#\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></svg>Protection<span class=\"ds-count\">1</span></a></nav>",
      "css": ".ds-nav{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;display:flex;flex-direction:column;gap:2px;width:220px;padding-left:16px}.ds-nav-item{position:relative;display:flex;align-items:center;gap:12px;min-height:44px;padding:0 14px;border-radius:12px;color:#34496A;font-weight:500;text-decoration:none;transition:background .15s,color .15s}.ds-nav-item:hover{background:#F3F8FE;color:#0B2348}.ds-nav-item:focus-visible{outline:2px solid #2498F3;outline-offset:2px}.ds-nav-item[aria-current=page]{background:#E7F4FF;color:#1570C0;font-weight:600}.ds-nav-item[aria-current=page]::before{content:\"\";position:absolute;left:-16px;top:10px;bottom:10px;width:3px;border-radius:0 3px 3px 0;background:#2498F3}.ds-count{margin-left:auto;font-size:12px;font-weight:600;min-width:22px;height:22px;border-radius:11px;display:grid;place-items:center;background:#FEF3E0;color:#94580A}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Paper surface on the morning background; interactive cards lift on hover.",
      "html": "<a class=\"ds-card\" href=\"#\"><div class=\"ds-card-head\"><div><h3>Device Protection Status</h3><p>Configuration state reported by each device</p></div><span class=\"ds-link2\">View all</span></div><div class=\"ds-inset\">An inset region uses the cloud surface, never another card.</div></a>",
      "css": ".ds-card{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;display:block;max-width:440px;background:#fff;border:1px solid #E2ECF7;border-radius:20px;padding:22px 24px;box-shadow:0 1px 2px rgba(11,35,72,.05);color:#0B2348;text-decoration:none;transition:transform .2s cubic-bezier(.2,.7,.2,1),box-shadow .2s cubic-bezier(.2,.7,.2,1),border-color .2s}.ds-card:hover{transform:translateY(-2px);box-shadow:0 1px 2px rgba(11,35,72,.04),0 8px 24px -12px rgba(11,35,72,.12);border-color:#CCDDEF}.ds-card:focus-visible{outline:2px solid #2498F3;outline-offset:2px}.ds-card-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:16px}.ds-card h3{font-family:Sora,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;margin:0;font-size:18px;font-weight:600;letter-spacing:-.015em}.ds-card p{margin:2px 0 0;font-size:13px;color:#5A6E91}.ds-link2{color:#1570C0;font-weight:600;font-size:14px;white-space:nowrap}.ds-inset{padding:16px;border-radius:14px;background:#F3F8FE;border:1px solid #E2ECF7;font-size:13.5px;color:#34496A}"
    },
    {
      "name": "Quick Action Row",
      "kind": "custom",
      "refersTo": "ico-tile",
      "description": "Icon tile, title and chevron; the chevron nudges right on hover.",
      "html": "<button class=\"ds-row\"><span class=\"ds-tile\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 22h14\"/><path d=\"M5 2h14\"/><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"/><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"/></svg></span><span class=\"ds-row-t\">Set Screen Time Limits</span><span class=\"ds-chev\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></span></button>",
      "css": ".ds-row{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;display:flex;align-items:center;gap:14px;width:340px;min-height:56px;padding:10px 12px;border-radius:12px;border:0;background:none;text-align:left;cursor:pointer;color:#0B2348;transition:background .15s}.ds-row:hover{background:#F3F8FE}.ds-row:focus-visible{outline:2px solid #2498F3;outline-offset:2px}.ds-tile{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;flex:none;background:#E7F4FF;color:#1570C0}.ds-row-t{flex:1;font-weight:600;font-size:14.5px}.ds-chev{color:#5A6E91;display:grid;transition:transform .15s,color .15s}.ds-row:hover .ds-chev{transform:translateX(2px);color:#1570C0}"
    },
    {
      "name": "Family Protection Metric",
      "kind": "custom",
      "refersTo": "card",
      "description": "Signature metric: Sora tabular score with a 10-segment meter and a status pill.",
      "html": "<div class=\"ds-metric\"><div class=\"ds-m-top\"><span>Family Protection</span><span class=\"ds-tile2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></svg></span></div><div class=\"ds-m-val\">7<small> / 10</small></div><div class=\"ds-seg\"><span class=\"on\"></span><span class=\"on\"></span><span class=\"on\"></span><span class=\"on\"></span><span class=\"on\"></span><span class=\"on\"></span><span class=\"on\"></span><span class=\"warn\"></span><span class=\"warn\"></span><span class=\"warn\"></span></div><span class=\"ds-pill2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg>Needs attention</span></div>",
      "css": ".ds-metric{font-family:'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;width:240px;display:flex;flex-direction:column;gap:12px;padding:20px 22px;background:#fff;border:1px solid #E2ECF7;border-radius:20px;box-shadow:0 1px 2px rgba(11,35,72,.05)}.ds-m-top{display:flex;justify-content:space-between;align-items:center;font-size:14px;font-weight:600;color:#34496A}.ds-tile2{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:#E7F4FF;color:#1570C0}.ds-m-val{font-family:Sora,'Hanken Grotesk',ui-sans-serif,system-ui,sans-serif;font-size:32px;font-weight:600;letter-spacing:-.02em;line-height:1;color:#0B2348;font-variant-numeric:tabular-nums}.ds-m-val small{font-size:18px;color:#5A6E91;font-weight:500}.ds-seg{display:grid;grid-template-columns:repeat(10,1fr);gap:3px}.ds-seg span{height:6px;border-radius:3px;background:#E2ECF7}.ds-seg .on{background:#2498F3}.ds-seg .warn{background:#F4A62A}.ds-pill2{align-self:flex-start;display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:13px;font-size:12.5px;font-weight:600;background:#FEF3E0;color:#94580A}.ds-pill2 svg{width:14px;height:14px}"
    }
  ],
  "narrative": {
    "northStar": "The Clear-Sky Checkup",
    "overview": "Every screen is a reassuring checkup under an open sky. The parent arrives asking \"is my family protected?\", and the page answers in calm daylight blues: soft morning backgrounds, white paper surfaces layered on top, deep navy ink for what matters. When something needs them, it shows up as a warm amber or coral note with the fix right beside it. It's clear and specific, and never alarming. The system is about verified facts on devices, so it reads like a well-kept checklist, not a security console.\n\nDensity is moderate and friendly. Targets are a generous 44px, corners are rounded but not bubbly, and type pairs a geometric display face (Sora) for headings and numbers with a warm grotesque (Hanken Grotesk) for everything people read. The one photographic moment is the dashboard hero: a sunlit family scene behind a pale wash, with the greeting and status chips in fixed navy so they stay legible in both themes. Everywhere else, color carries meaning rather than decoration.\n\nThe app supports light, dark and system themes from the same tokens. Dark mode is a deep night-navy version of the same sky, not an inversion. The public landing page (`src/app/landing.css`) is a separate, light-only marketing variant that shares the ink, fonts and blue family but has its own bigger buttons and gradients. This document covers the signed-in app.",
    "keyCharacteristics": [
      "Soft, layered daylight surfaces: morning background → paper cards → cloud and haze insets.",
      "Navy ink hierarchy in three steps; sky blue for action and selection only.",
      "Status is spoken in three tones (verified green, attention amber, critical coral), each with a soft fill and a darker ink.",
      "Sora for headings and figures, Hanken Grotesk for reading, tabular numerals for every count and time.",
      "Friendly and precise: rounded 10–20px corners, 44px targets, labels that name the action."
    ],
    "rules": [
      {
        "name": "The Ink-for-Text Rule",
        "section": "colors",
        "body": "Text is always an `-ink` token (`--ink`, `--ink-2`, `--ink-3`, `--accent-ink`, `--ok-ink`, `--warn-ink`, `--crit-ink`), never the bright fill (`--accent`, `--ok`, `--warn`, `--crit`). Bright fills are for bars, dots, icons and meters."
      },
      {
        "name": "The Soft-Fill Pairing Rule",
        "section": "colors",
        "body": "Every status shows as its soft fill with its ink on top (pill, icon tile, callout), so a state reads the same anywhere it appears."
      },
      {
        "name": "The Sky Is Not Decoration Rule",
        "section": "colors",
        "body": "Blue means \"you can act here\" or \"this is selected\". Don't use it to color headings, borders or empty space."
      },
      {
        "name": "The Tabular Figures Rule",
        "section": "typography",
        "body": "Every count, score, duration and time gets `.num` (`font-variant-numeric: tabular-nums`) so numbers don't jitter as they update."
      },
      {
        "name": "The Two-Face Rule",
        "section": "typography",
        "body": "Sora is for headings, the brand name, avatars' initials and large figures. Everything a parent reads in sentences is Hanken Grotesk."
      },
      {
        "name": "The No Empty Thirds Rule",
        "section": "layout",
        "body": "A grid of one or two items must not leave a blank two-thirds of a row: switch to a wide row layout."
      },
      {
        "name": "The Three Layers Rule",
        "section": "elevation",
        "body": "Background, paper, inset. A card never sits inside another card. Use a Cloud Surface inset (`.act`, `.device-visual`) for a sub-region."
      },
      {
        "name": "The Lift-Means-Clickable Rule",
        "section": "elevation",
        "body": "Only `.interactive` cards rise and gain the Lift shadow on hover. Static cards stay at Rest."
      }
    ],
    "dos": [
      "Do pair every status with its soft fill and ink (`tone-ok`, `tone-warn`, `tone-crit`, `tone-muted`) and an icon, so status never relies on color alone.",
      "Do keep touch targets at least 44px (buttons, nav items, list rows, icon buttons).",
      "Do use `.num` tabular figures for every number and time.",
      "Do give every surface its light and dark value from the tokens. Never hard-code a color outside the hero.",
      "Do put the fix next to the problem: a warn or crit state in a card links to the action that resolves it.",
      "Do let lone items fill the row (the No Empty Thirds Rule)."
    ],
    "donts": [
      "Don't darken a surface behind Mist Ink beyond Haze Surface. Mist Ink was tuned to clear 4.5:1 (WCAG AA) on every light surface up to Haze and on muted pills; anything darker needs Slate Ink.",
      "Don't use the bright status fills or Sky Accent for text. Use the `-ink` variant.",
      "Don't nest a card inside a card. Use a Cloud Surface inset.",
      "Don't add new shadow recipes or neutral-black shadows in light mode. Use Rest, Lift or Float.",
      "Don't use blue for decoration. It marks actions and selection.",
      "Don't add glass or blur outside the hero."
    ]
  }
}
