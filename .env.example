DATABASE_URL="postgresql://eguard:eguard_dev_password@127.0.0.1:55433/eguard?schema=public"
# Public URL of this server, used in links we email (e.g. "verify your email")
APP_URL="http://localhost:3000"
# Outgoing email over SMTP: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465.
# URL-encode special characters in the password. Dev: the Mailpit container (`npm run db:up`).
# Empty: emails are printed to the server log instead of sent (not allowed in production).
SMTP_URL="smtp://127.0.0.1:1025"
MAIL_FROM="eGuard <no-reply@eguard.app>"
# Dev only: simulated devices answer configuration requests and checks
DEVICE_SIMULATOR="true"
# Parent mobile app: "Continue with Apple / Google". Comma-separated client ids the ID token's
# audience must match (iOS bundle id / Services ID; Google iOS, Android and web client ids).
# Leave empty to hide the buttons (/app-info) and return 501 from /auth/social.
APPLE_CLIENT_IDS=""
GOOGLE_CLIENT_IDS=""
# Android "Upgrade to Family" (Google Play Billing). The service account's JSON key, on one line; grant it
# "View financial data" and "Manage orders and subscriptions" in Play Console. Leave empty to disable.
GOOGLE_PLAY_PACKAGE_NAME=""
GOOGLE_PLAY_SERVICE_ACCOUNT=""
# Oldest parent-app version this server supports (the app asks users to update below it)
MOBILE_MIN_APP_VERSION="1.0.0"
# Where support requests are forwarded, and the address the apps show
SUPPORT_EMAIL="support@eguard.app"
# Background jobs: call /api/cron/maintenance every 5–15 minutes with "Authorization: Bearer <this>".
# Required in production (without it the endpoint refuses); generate with: openssl rand -base64 32
CRON_SECRET=""
# Proxies in front of the app that append to X-Forwarded-For (default 1). Per-address rate limits use the
# address the nearest trusted proxy saw, so clients can't spoof it.
TRUSTED_PROXY_HOPS="1"
# Addresses exempt from per-address rate limits (comma-separated), e.g. "::1,127.0.0.1" for a local test run
RATE_LIMIT_IP_ALLOWLIST=""
# Google Play Real-time Developer Notifications (Pub/Sub push with authentication): the push subscription's
# audience and service account email. Leave empty to disable /api/billing/google-play/notifications.
GOOGLE_PLAY_RTDN_AUDIENCE=""
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=""
