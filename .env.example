DATABASE_URL="postgresql://eguard:eguard_dev_password@127.0.0.1:15433/eguard?schema=public"
# Public URL of this server, used in links we email (e.g. "verify your email") and in canonical URLs, the sitemap,
# robots.txt, share tags and structured data. Production: "https://www.eguard.family".
APP_URL="http://localhost:3000"
# Map tiles, fetched by the server (api/tiles) so the provider never sees parents' IPs. Default is OpenStreetMap,
# fine for development and light use; in production use a provider you have terms with, key included, e.g.
# "https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY" (the map credits MapTiler then;
# other providers: add their credit in src/lib/map-tiles.ts). Server logs "[tiles] The tile provider answered 403" when the key is refused.
MAP_TILE_URL=""
# Referer sent with tile requests, for a key limited to allowed websites (MapTiler "Allowed HTTP origins"):
# one of the sites the key allows. Empty: APP_URL, which is enough in production when the key allows
# *.eguard.family. In development (APP_URL is localhost) use "https://www.eguard.family/". Note *.eguard.family
# doesn't cover the bare eguard.family.
MAP_TILE_REFERER=""
# Outgoing email over SMTP: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465.
# URL-encode special characters in the password. Dev: the Mailpit container (`npm run db:up`).
# Empty: emails are printed to the server log instead of sent (not allowed in production).
SMTP_URL="smtp://127.0.0.1:1025"
MAIL_FROM="eGuard <no-reply@eguard.family>"
# Optional fallback: Resend (resend.com) sends when SMTP_URL is empty or the SMTP send fails.
# RESEND_FROM must be on a domain verified in Resend; empty uses MAIL_FROM.
RESEND_API_KEY=""
RESEND_FROM=""
# Dev only: simulated devices answer configuration requests and checks
DEVICE_SIMULATOR="true"
# Parent mobile app: "Continue with Apple / Google". Comma-separated client ids the ID token's
# audience must match (iOS bundle id / Services ID; Google iOS, Android and web client ids).
# Leave empty to hide the buttons (/app-info) and return 501 from /auth/social.
APPLE_CLIENT_IDS=""
GOOGLE_CLIENT_IDS=""
# Web payments (PayMongo): the only way to buy a plan for now. Test keys (sk_test_/pk_test_) in development,
# live keys in production; don't mix them. Leave empty to hide buying (Settings › Subscription says to contact support).
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
# Secret of the webhook endpoint (Developers › Webhooks) pointing at /api/billing/paymongo/webhook
PAYMONGO_WEBHOOK_SECRET=""
# Methods offered for one-time passes; each must be activated on the PayMongo account
PAYMONGO_PASS_METHODS="gcash,paymaya,card,qrph"
# Monthly plan prices in pesos (eGuard Plus, Family Pro), for auto-renew and one-month passes alike
PRICE_PLUS_MONTHLY="149"
PRICE_PRO_MONTHLY="249"
# Android upgrades (Google Play Billing; products eguard_plus and eguard_pro). The service account's JSON key, on one line; grant it
# "View financial data" and "Manage orders and subscriptions" in Play Console. Leave empty to disable
# (the default while payments are web-only: the app then shows the plan without a buy button).
GOOGLE_PLAY_PACKAGE_NAME=""
GOOGLE_PLAY_SERVICE_ACCOUNT=""
# Push notifications to the parent app (Firebase Cloud Messaging, Android and iOS). The Firebase project's service
# account JSON key, on one line, with the "Firebase Cloud Messaging API Admin" role. Empty: no pushes are sent.
FCM_SERVICE_ACCOUNT=""
# Encrypts two-step verification secrets. Any long random string (e.g. `openssl rand -base64 32`); never change it
# once parents have turned two-step on, or their codes stop working. Required in production for two-step to be offered.
TWO_FACTOR_KEY=""
# Oldest parent-app version this server supports (the app asks users to update below it)
MOBILE_MIN_APP_VERSION="1.0.0"
# Oldest child-device app version, returned by /api/device/v1/sync as minAppVersion. One version for both platforms
# ("1.2.0") or one each ("android:1.2.0,ios:1.1.0"). Empty: no minimum (minAppVersion is null)
CHILD_MIN_APP_VERSION=""
# Where support requests are forwarded, and the address the apps show
SUPPORT_EMAIL="support@devcomdigital.com"
# Background jobs: call /api/cron/maintenance every 5–15 minutes with "Authorization: Bearer <this>".
# Required in production (without it the endpoint refuses); generate with: openssl rand -base64 32
CRON_SECRET=""
# Proxies in front of the app that append to X-Forwarded-For (default 1). Per-address rate limits use the
# address the nearest trusted proxy saw, so clients can't spoof it.
TRUSTED_PROXY_HOPS="1"
# Addresses exempt from per-address rate limits (comma-separated), e.g. "::1,127.0.0.1" for a local test run
RATE_LIMIT_IP_ALLOWLIST=""
# Optional: site verification by HTML tag, for Google Search Console and Bing Webmaster Tools.
# Not needed if you verify by DNS record (recommended).
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
# Optional: Meta Pixel ID (digits only), only if you run Facebook ads. Read at build time: it turns on the pixel
# on public marketing pages and the matching Cookies text in the privacy policy, together. Leave empty for neither.
NEXT_PUBLIC_META_PIXEL_ID=""
# Google Play Real-time Developer Notifications (Pub/Sub push with authentication): the push subscription's
# audience and service account email. Leave empty to disable /api/billing/google-play/notifications.
GOOGLE_PLAY_RTDN_AUDIENCE=""
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=""

# Signs browser policies for the eGuard browser extension (ECDSA P-256, base64 PKCS#8 DER).
# Generate with: node scripts/browser-policy-keys.mjs  (the public half goes in the extension build).
# Without it, /api/browser/v1/policy answers 503 and browsers keep their last policy.
BROWSER_POLICY_SIGNING_KEY=""
