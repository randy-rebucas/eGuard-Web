generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  FAMILY_ADMIN
  PARENT
}

enum Platform {
  ANDROID
  IOS
}

enum DeviceKind {
  PHONE
  TABLET
}

/// Protection keys double as the 10 Configuration Health checks.
enum ProtectionKey {
  SCREEN_TIME
  BEDTIME
  APP_RESTRICTIONS
  APP_APPROVAL
  CONTENT
  WEB
  DOWNLOADS
  LOCATION
  NOTIFICATIONS
  UNINSTALL_PROTECTION
}

enum CheckStatus {
  PASS
  WARNING
  ACTION_REQUIRED
  UNSUPPORTED
  NOT_CONFIGURED
}

enum RequestMode {
  APPLY   // eGuard applies it on the device directly
  GUIDED  // parent performs steps on the device, eGuard verifies
}

enum RequestStatus {
  PENDING          // waiting for the device to pick it up
  AWAITING_PARENT  // guided setup: waiting for parent to finish steps
  DELIVERED        // device received it / verification requested
  VERIFIED         // device reported config matching the request
  FAILED           // device reported a mismatch or an error
  CANCELLED
}

enum AlertSeverity {
  INFO
  ATTENTION
  ACTION_REQUIRED
  CRITICAL
}

enum AlertCategory {
  PROTECTION
  DEVICES
  APPS
  SCREEN_TIME
  LOCATION
  SYSTEM
}

enum AppApproval {
  ALLOWED
  ALWAYS_ALLOWED
  FILTERED
  BLOCKED
  PENDING
}

enum CheckRunStatus {
  RUNNING
  COMPLETED
}

// ---------- Account ----------

model Family {
  id            String   @id @default(cuid())
  name          String
  timezone      String   @default("Asia/Manila")
  plan          String   @default("eGuard Plus")
  deviceLimit   Int      @default(8)
  renewsAt      DateTime?
  /// PayMongo customer (cus_…) that web subscriptions bill
  paymongoCustomerId String? @unique
  // privacy & notification settings
  keepLocationHistory Boolean @default(false)
  shareAnalytics      Boolean @default(false)
  retentionDays       Int     @default(90)
  createdAt     DateTime @default(now())

  users        User[]
  children     Child[]
  devices      Device[]
  alerts       Alert[]
  changes      ConfigChange[]
  pairingCodes PairingCode[]
  checkRuns    CheckRun[]
  auditLogs    AuditLog[]
  purchases    StorePurchase[]
  supportTickets SupportTicket[]
}

model User {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  email        String   @unique
  /// Set when the parent opens the link we emailed, or signs in with a provider-verified email.
  /// Cleared when the email changes. Unverified parents can't pair a child's device.
  emailVerifiedAt DateTime?
  name         String
  passwordHash String
  /// false for Apple/Google sign-ups until they set a password (through "Forgot password")
  passwordSet  Boolean  @default(true)
  role         Role     @default(PARENT)
  // notification preferences
  notifyPush     Boolean @default(true)
  notifyEmail    Boolean @default(true)
  notifyApproval Boolean @default(true)
  weeklySummary  Boolean @default(true)
  twoFactor      Boolean @default(false)
  passwordChangedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  sessions Session[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
  readAlerts AlertRead[]
  identities OAuthIdentity[]
  pushTokens PushToken[]
  supportTickets SupportTicket[]
}

/// A single-use "verify your email" link. Only the SHA-256 of the token is stored; `email` is the
/// address it was sent to, so a link stops working if the parent changes their email meanwhile.
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A single-use "reset your password" link (SHA-256 of the token only). Valid for an hour.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Fixed-window counters for rate limits, shared by every server instance.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Sign in with Apple / Google. `subject` is the provider's stable user id.
model OAuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

/// APNs/FCM tokens for the parent's own phone (delivery provider not wired yet).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A plan purchase, verified with the store or payment provider. One purchase token belongs to one family.
model StorePurchase {
  id            String   @id @default(cuid())
  familyId      String
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  store         String   // "GOOGLE_PLAY" | "PAYMONGO"
  productId     String
  /// Google Play purchase token; PayMongo checkout session id (cs_…) or subscription id (subs_…)
  purchaseToken String   @unique
  /// store state, e.g. SUBSCRIPTION_STATE_ACTIVE or PayMongo's active; REPLACED when a newer purchase supersedes it
  state         String
  autoRenewing  Boolean  @default(false)
  /// end of the paid period
  expiresAt     DateTime?
  /// PayMongo payment (pay_…) of a prepaid pass, to match refunds
  paymentId     String?
  /// when the "your pass ends soon" reminder went out
  remindedAt    DateTime?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([familyId])
  @@index([paymentId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
}

// ---------- Children & devices ----------

model Child {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name       String
  birthYear  Int
  hue        Int      @default(205)
  dailyLimitMinutes   Int @default(180)
  weekendLimitMinutes Int @default(240)
  createdAt  DateTime @default(now())

  devices    Device[]
  policies   ChildPolicy[]
  usage      ScreenTimeDaily[]
  appUsage   AppUsageDaily[]
  apps       ChildApp[]
  changes    ConfigChange[]
  requests   ConfigRequest[]
  alerts     Alert[]
  photo      ChildPhoto?
  visits     LocationVisit[]
}

/// Profile photo, kept out of Child so ordinary queries don't load the bytes.
model ChildPhoto {
  childId     String   @id
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
}

/// Desired configuration per child and protection (what the parent asked for).
model ChildPolicy {
  id        String        @id @default(cuid())
  childId   String
  child     Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  key       ProtectionKey
  config    Json
  updatedAt DateTime      @updatedAt

  @@unique([childId, key])
}

model Device {
  id          String     @id @default(cuid())
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId     String
  child       Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  name        String
  model       String
  kind        DeviceKind @default(PHONE)
  platform    Platform
  osVersion   String
  isPrimary   Boolean    @default(false)
  battery     Int?
  appVersion  String?
  tokenHash   String?    @unique
  lastSeenAt  DateTime?
  checkRequestedAt DateTime?
  /// Dev-only: device is driven by the built-in simulator
  simulated   Boolean    @default(false)
  simulatedOnline Boolean @default(true)
  createdAt   DateTime   @default(now())

  protections DeviceProtection[]
  requests    ConfigRequest[]
  location    DeviceLocation?
  usage       ScreenTimeDaily[]
  appUsage    AppUsageDaily[]
  checkResults CheckRunResult[]
  visits      LocationVisit[]
}

/// Verified state per device and protection (what the device reported).
model DeviceProtection {
  id             String        @id @default(cuid())
  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key            ProtectionKey
  status         CheckStatus
  reported       Json?
  message        String?
  lastVerifiedAt DateTime?

  @@unique([deviceId, key])
}

model DeviceLocation {
  deviceId   String   @id
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sharing    Boolean  @default(true)
  lat        Float?
  lng        Float?
  accuracyM  Float?
  placeLabel String?
  /// when the coordinates were last reported (not when sharing state changed)
  locatedAt  DateTime?
  updatedAt  DateTime @updatedAt
}

/// Places a device stayed at. Only written when the family turns on location history.
model LocationVisit {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  placeLabel String?
  arrivedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([childId, arrivedAt])
  @@index([deviceId, arrivedAt])
}

model PairingCode {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  code      String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ---------- Activity ----------

model ScreenTimeDaily {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  minutes  Int
  /// 24 per-hour totals in the family's timezone, when the device sends them
  hourly   Int[]    @default([])

  @@unique([deviceId, date])
  @@index([childId, date])
}

/// Per device, so a child's phone and tablet don't overwrite each other; sum across devices to show a child's total.
model AppUsageDaily {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  app      String
  minutes  Int

  @@unique([deviceId, date, app])
  @@index([childId, date])
}

model ChildApp {
  id         String      @id @default(cuid())
  childId    String
  child      Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  name       String
  approval   AppApproval @default(ALLOWED)
  dailyLimitMinutes Int?
  installedAt DateTime   @default(now())

  @@unique([childId, name])
}

// ---------- Configuration workflow ----------

model ConfigRequest {
  id          String        @id @default(cuid())
  batchId     String
  childId     String
  child       Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId    String
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key         ProtectionKey
  mode        RequestMode
  desired     Json
  previous    Json?
  status      RequestStatus @default(PENDING)
  failureReason String?
  createdBy   String
  createdAt   DateTime      @default(now())
  deliveredAt DateTime?
  verifiedAt  DateTime?

  @@index([deviceId, status])
  @@index([batchId])
}

/// Configuration history: only written for verified changes or on-device changes.
model ConfigChange {
  id        String        @id @default(cuid())
  familyId  String
  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  child     Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  key       ProtectionKey
  title     String
  actor     String
  fromValue String?
  toValue   String?
  createdAt DateTime      @default(now())

  @@index([familyId, createdAt])
}

model CheckRun {
  id          String         @id @default(cuid())
  familyId    String
  family      Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  status      CheckRunStatus @default(RUNNING)
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  results     CheckRunResult[]
}

model CheckRunResult {
  id         String   @id @default(cuid())
  runId      String
  run        CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reachable  Boolean?
  issues     Int?
  reportedAt DateTime?

  @@unique([runId, deviceId])
}

// ---------- Alerts ----------

model Alert {
  id         String        @id @default(cuid())
  familyId   String
  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId    String?
  child      Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId   String?
  severity   AlertSeverity
  category   AlertCategory
  icon       String
  title      String
  body       String
  subject    String
  fromValue  String?
  toValue    String?
  /// what resolves it, e.g. "BEDTIME:<deviceId>"
  resolveKey String?
  resolvedAt DateTime?
  /// when parents were emailed about it (set once, even if nobody wanted email)
  notifiedAt DateTime?
  createdAt  DateTime      @default(now())

  reads AlertRead[]

  @@index([familyId, createdAt])
}

model AlertRead {
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt  DateTime @default(now())

  @@id([alertId, userId])
}
