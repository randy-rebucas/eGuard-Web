generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  FAMILY_ADMIN
  PARENT
}

enum Platform {
  ANDROID
  IOS
}

enum DeviceKind {
  PHONE
  TABLET
}

/// Protection keys double as the 10 Configuration Health checks.
enum ProtectionKey {
  SCREEN_TIME
  BEDTIME
  APP_RESTRICTIONS
  APP_APPROVAL
  CONTENT
  WEB
  DOWNLOADS
  LOCATION
  NOTIFICATIONS
  UNINSTALL_PROTECTION
}

enum CheckStatus {
  PASS
  WARNING
  ACTION_REQUIRED
  UNSUPPORTED
  NOT_CONFIGURED
}

enum RequestMode {
  APPLY   // eGuard applies it on the device directly
  GUIDED  // parent performs steps on the device, eGuard verifies
}

enum RequestStatus {
  PENDING          // waiting for the device to pick it up
  AWAITING_PARENT  // guided setup: waiting for parent to finish steps
  DELIVERED        // device received it / verification requested
  VERIFIED         // device reported config matching the request
  FAILED           // device reported a mismatch or an error
  CANCELLED
}

enum AlertSeverity {
  INFO
  ATTENTION
  ACTION_REQUIRED
  CRITICAL
}

enum AlertCategory {
  PROTECTION
  DEVICES
  APPS
  SCREEN_TIME
  LOCATION
  SYSTEM
}

enum AppApproval {
  ALLOWED
  ALWAYS_ALLOWED
  FILTERED
  BLOCKED
  PENDING
}

enum PairingKind {
  DEVICE   // the child app on a phone or tablet (/api/device/v1/pair)
  BROWSER  // the eGuard browser extension (/api/browser/v1/pair)
}

enum CheckRunStatus {
  RUNNING
  COMPLETED
}

enum OrgKind {
  SCHOOL
  COMMUNITY
  BUSINESS
}

enum OrgRole {
  OWNER
  ADMIN
}

// ---------- Account ----------

model Family {
  id            String   @id @default(cuid())
  name          String
  timezone      String   @default("Asia/Manila")
  plan          String   @default("Free")
  deviceLimit   Int      @default(2)
  renewsAt      DateTime?
  /// PayMongo customer (cus_…) that web subscriptions bill
  paymongoCustomerId String? @unique
  // privacy & notification settings
  keepLocationHistory Boolean @default(false)
  shareAnalytics      Boolean @default(false)
  retentionDays       Int     @default(90)
  createdAt     DateTime @default(now())

  users        User[]
  children     Child[]
  devices      Device[]
  alerts       Alert[]
  changes      ConfigChange[]
  pairingCodes PairingCode[]
  browsers     BrowserInstallation[]
  checkRuns    CheckRun[]
  auditLogs    AuditLog[]
  purchases    StorePurchase[]
  supportTickets SupportTicket[]
  orgMemberships OrgMembership[]
  vouchers     Voucher[]
}

model User {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  email        String   @unique
  /// Set when the parent opens the link we emailed, or signs in with a provider-verified email.
  /// Cleared when the email changes. Unverified parents can't pair a child's device.
  emailVerifiedAt DateTime?
  name         String
  passwordHash String
  /// false for Apple/Google sign-ups until they set a password (through "Forgot password")
  passwordSet  Boolean  @default(true)
  role         Role     @default(PARENT)
  // notification preferences
  notifyPush     Boolean @default(true)
  notifyEmail    Boolean @default(true)
  notifyApproval Boolean @default(true)
  weeklySummary  Boolean @default(true)
  twoFactor      Boolean @default(false)
  passwordChangedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  sessions Session[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
  readAlerts AlertRead[]
  identities OAuthIdentity[]
  pushTokens PushToken[]
  supportTickets SupportTicket[]
  orgRoles   OrgMember[]
  orgApiKeys OrgApiKey[]

  @@index([familyId])
}

/// A single-use "verify your email" link. Only the SHA-256 of the token is stored; `email` is the
/// address it was sent to, so a link stops working if the parent changes their email meanwhile.
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A single-use "reset your password" link (SHA-256 of the token only). Valid for an hour.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Fixed-window counters for rate limits, shared by every server instance.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Sign in with Apple / Google. `subject` is the provider's stable user id.
model OAuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

/// APNs/FCM tokens for the parent's own phone (delivery provider not wired yet).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A plan purchase, verified with the store or payment provider. One purchase token belongs to one family.
model StorePurchase {
  id            String   @id @default(cuid())
  familyId      String
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  store         String   // "GOOGLE_PLAY" | "PAYMONGO"
  productId     String
  /// Google Play purchase token; PayMongo checkout session id (cs_…) or subscription id (subs_…)
  purchaseToken String   @unique
  /// store state, e.g. SUBSCRIPTION_STATE_ACTIVE or PayMongo's active; REPLACED when a newer purchase supersedes it
  state         String
  autoRenewing  Boolean  @default(false)
  /// end of the paid period
  expiresAt     DateTime?
  /// PayMongo payment (pay_…) of a prepaid pass, to match refunds
  paymentId     String?
  /// when the "your pass ends soon" reminder went out
  remindedAt    DateTime?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([familyId])
  @@index([paymentId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
}

// ---------- Organizations (docs/organizations.md) ----------

/**
 * A school, community group or business that helps families: they join it with its code, and it can buy
 * sponsor codes that pay for families' plans. It never sees a family's data, only counts.
 */
model Organization {
  id        String   @id @default(cuid())
  name      String
  kind      OrgKind
  /// XXXXXXXX (shown as XXXX-XXXX); replacing it stops the old one working
  joinCode  String   @unique
  createdAt DateTime @default(now())
  /// When admins were last sent the daily activity email (covers OrgEvents up to this time)
  digestSentAt DateTime?

  members     OrgMember[]
  memberships OrgMembership[]
  batches     VoucherBatch[]
  events      OrgEvent[]
  apiKeys     OrgApiKey[]
}

/// A key for the organization API (/api/org/v1, docs/organization-api.md). Only its hash is stored.
model OrgApiKey {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  /// The start of the key (egk_ + 8 characters), shown so admins can tell keys apart
  prefix      String
  tokenHash   String       @unique
  /// READ, or WRITE (read, and cancel codes)
  access      String       @default("READ")
  /// Works while this admin manages the organization and their family's plan includes API access
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([orgId])
}

/// Something that happened in an organization, for the admins' daily email. Deliberately has no family:
/// the email says how many, never who. Kept 30 days.
model OrgEvent {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// JOINED | LEFT | REDEEMED | CANCELLED
  kind      String
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
}

/// An eGuard user who manages an organization. They stay in their own family; this only adds a role.
model OrgMember {
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgRole      @default(ADMIN)
  createdAt DateTime     @default(now())

  @@id([orgId, userId])
  @@index([userId])
}

/// A family that joined an organization with its join code. Only the family can create or remove it.
model OrgMembership {
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  familyId String
  family   Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  joinedAt DateTime     @default(now())

  @@id([orgId, familyId])
  @@index([familyId])
}

/// One purchase of sponsor codes (one PayMongo checkout). Codes are created when the payment is confirmed.
model VoucherBatch {
  /// Also the checkout's reference number
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// PLUS | PRO
  plan          String
  /// 1, 3, 6 or 12
  months        Int
  quantity      Int
  /// Total charged, centavos
  amount        Int
  /// PayMongo checkout session (cs_…)
  purchaseToken String   @unique
  /// PENDING | PAID | EXPIRED | VOIDED
  state         String   @default("PENDING")
  /// PayMongo payment (pay_…), to match refunds
  paymentId     String?
  paidAt        DateTime?
  /// User id of the admin who bought it
  createdBy     String
  /// When admins were told its unused codes' redeem-by date is near
  expiryRemindedAt DateTime?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  vouchers Voucher[]

  @@index([orgId, createdAt])
  @@index([paymentId])
}

/// A sponsor code: one family redeems it once for the batch's plan and months.
model Voucher {
  id         String       @id @default(cuid())
  batchId    String
  batch      VoucherBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// XXXXXXXXXXXX (shown as XXXX-XXXX-XXXX). Stored so admins can view and hand out their codes
  code       String       @unique
  /// Redeem by
  expiresAt  DateTime
  redeemedAt DateTime?
  /// The family that redeemed it. For support and refunds only: never shown to the organization
  familyId   String?
  family     Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)
  /// Cancelled by an admin, or by a refund of the batch
  revokedAt  DateTime?

  @@index([batchId])
  @@index([familyId])
}

// ---------- Children & devices ----------

model Child {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name       String
  birthYear  Int
  hue        Int      @default(205)
  dailyLimitMinutes   Int @default(180)
  weekendLimitMinutes Int @default(240)
  createdAt  DateTime @default(now())

  devices    Device[]
  policies   ChildPolicy[]
  usage      ScreenTimeDaily[]
  appUsage   AppUsageDaily[]
  apps       ChildApp[]
  changes    ConfigChange[]
  requests   ConfigRequest[]
  alerts     Alert[]
  browsers   BrowserInstallation[]
  browserPolicy BrowserPolicy?
  accessRequests BrowserAccessRequest[]
  photo      ChildPhoto?
  visits     LocationVisit[]

  @@index([familyId])
}

/// Profile photo, kept out of Child so ordinary queries don't load the bytes.
model ChildPhoto {
  childId     String   @id
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
}

/// Desired configuration per child and protection (what the parent asked for).
model ChildPolicy {
  id        String        @id @default(cuid())
  childId   String
  child     Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  key       ProtectionKey
  config    Json
  updatedAt DateTime      @updatedAt

  @@unique([childId, key])
}

model Device {
  id          String     @id @default(cuid())
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId     String
  child       Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  name        String
  model       String
  kind        DeviceKind @default(PHONE)
  platform    Platform
  osVersion   String
  isPrimary   Boolean    @default(false)
  battery     Int?
  appVersion  String?
  tokenHash   String?    @unique
  lastSeenAt  DateTime?
  checkRequestedAt DateTime?
  /// Dev-only: device is driven by the built-in simulator
  simulated   Boolean    @default(false)
  simulatedOnline Boolean @default(true)
  createdAt   DateTime   @default(now())

  protections DeviceProtection[]
  requests    ConfigRequest[]
  location    DeviceLocation?
  usage       ScreenTimeDaily[]
  appUsage    AppUsageDaily[]
  checkResults CheckRunResult[]
  visits      LocationVisit[]

  @@index([familyId])
  @@index([childId])
}

/// Verified state per device and protection (what the device reported).
model DeviceProtection {
  id             String        @id @default(cuid())
  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key            ProtectionKey
  status         CheckStatus
  reported       Json?
  message        String?
  lastVerifiedAt DateTime?

  @@unique([deviceId, key])
}

model DeviceLocation {
  deviceId   String   @id
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sharing    Boolean  @default(true)
  lat        Float?
  lng        Float?
  accuracyM  Float?
  placeLabel String?
  /// when the coordinates were last reported (not when sharing state changed)
  locatedAt  DateTime?
  updatedAt  DateTime @updatedAt
}

/// Places a device stayed at. Only written when the family turns on location history.
model LocationVisit {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  placeLabel String?
  arrivedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([childId, arrivedAt])
  @@index([deviceId, arrivedAt])
}

model PairingCode {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  code      String   @unique
  kind      PairingKind @default(DEVICE)
  /// BROWSER codes: the computer the parent is adding, e.g. "Mia's MacBook"
  deviceLabel String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([childId])
}

/**
 * The eGuard browser extension in one browser on a child's computer. Counts toward the plan's device limit.
 * Credentials: a refresh token that rotates on every use and a 15-minute access token, both stored as SHA-256.
 * The previous refresh token is kept so a replayed (copied) one can be detected.
 */
model BrowserInstallation {
  id                   String    @id @default(cuid())
  familyId             String
  family               Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId              String
  child                Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// Entered by the parent with the pairing code; nothing is read from the machine
  deviceLabel          String
  browser              String
  browserVersion       String?
  extensionVersion     String
  /// runtime.getPlatformInfo().os: win, mac, linux, cros, …
  platform             String
  refreshTokenHash     String?   @unique
  prevRefreshTokenHash String?   @unique
  refreshRotatedAt     DateTime?
  accessTokenHash      String?   @unique
  accessTokenExpiresAt DateTime?
  lastSeenAt           DateTime?
  /// Set when eGuard disconnected it for security (a copied refresh token was used)
  revokedAt            DateTime?
  /// From the latest health report: the extension's own answer (PROTECTED, NEEDS_ATTENTION, …), null until the first
  protectionState      String?
  /// The policy version the browser says it is enforcing
  appliedPolicyVersion Int?
  lastHealthAt         DateTime?
  createdAt            DateTime  @default(now())

  healthChecks BrowserHealthCheck[]
  dailyEvents  BrowserEventDaily[]

  @@index([familyId])
  @@index([childId])
}

/// One health report from the extension: its self-checks and the policy version it enforces.
model BrowserHealthCheck {
  id             String              @id @default(cuid())
  installationId String
  installation   BrowserInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  policyVersion  Int?
  /// ProtectionState the extension showed
  state          String
  /// [{ id, status }]
  checks         Json
  /// Passing checks, out of those that apply (UNSUPPORTED and NOT_CONFIGURED don't count)
  score          Int
  total          Int
  createdAt      DateTime            @default(now())

  @@index([installationId, createdAt])
}

/// Aggregated only: how many pages of one kind were blocked in a browser on a day. Never a URL or domain.
model BrowserEventDaily {
  installationId String
  installation   BrowserInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  /// The day in the family's time zone
  date           DateTime            @db.Date
  /// A WebCategory, or BLOCKED_SITE / UNKNOWN_SITE / FOCUS_HOURS
  category       String
  blockedCount   Int

  @@id([installationId, date, category])
}

/**
 * What the eGuard browser extension enforces for one child, shared by all of that child's browsers.
 * `version` goes up on every change; the extension refuses to move backwards. Created with age-based
 * defaults the first time it's needed.
 */
model BrowserPolicy {
  id                 String   @id @default(cuid())
  childId            String   @unique
  child              Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  version            Int      @default(1)
  safeBrowsing       Boolean  @default(true)
  safeSearch         Boolean  @default(true)
  blockedCategories  String[]
  blockedDomains     String[]
  allowedDomains     String[]
  /// ALLOW | WARN | BLOCK
  unknownSitesPolicy String   @default("ALLOW")
  /// { enabled, startTime "HH:MM", endTime "HH:MM" } in the family's timezone, or null
  schedule           Json?
  /// Sites a parent approved for a while: [{ domain, until (ISO) }]. Expired entries are pruned on the next change.
  temporaryAllows    Json     @default("[]")
  updatedBy          String
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  versions BrowserPolicyVersion[]
}

/// A child asking, from the browser's block page, to open a blocked site. The parent approves or denies.
model BrowserAccessRequest {
  id             String    @id @default(cuid())
  familyId       String
  childId        String
  child          Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  installationId String?
  domain         String
  reason         String?
  /// PENDING | APPROVED | DENIED
  status         String    @default("PENDING")
  /// 15M | 1H | TODAY | ALWAYS, when approved
  duration       String?
  expiresAt      DateTime?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([childId, status])
  @@index([familyId, createdAt])
}

/// Immutable snapshot of every version: what was in force when, and who changed it.
model BrowserPolicyVersion {
  id        String        @id @default(cuid())
  policyId  String
  policy    BrowserPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  createdBy String
  createdAt DateTime      @default(now())

  @@unique([policyId, version])
}

// ---------- Activity ----------

model ScreenTimeDaily {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  minutes  Int
  /// 24 per-hour totals in the family's timezone, when the device sends them
  hourly   Int[]    @default([])

  @@unique([deviceId, date])
  @@index([childId, date])
}

/// Per device, so a child's phone and tablet don't overwrite each other; sum across devices to show a child's total.
model AppUsageDaily {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  app      String
  minutes  Int

  @@unique([deviceId, date, app])
  @@index([childId, date])
}

model ChildApp {
  id         String      @id @default(cuid())
  childId    String
  child      Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  name       String
  approval   AppApproval @default(ALLOWED)
  dailyLimitMinutes Int?
  installedAt DateTime   @default(now())

  @@unique([childId, name])
}

// ---------- Configuration workflow ----------

model ConfigRequest {
  id          String        @id @default(cuid())
  batchId     String
  childId     String
  child       Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId    String
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key         ProtectionKey
  mode        RequestMode
  desired     Json
  previous    Json?
  status      RequestStatus @default(PENDING)
  failureReason String?
  createdBy   String
  createdAt   DateTime      @default(now())
  deliveredAt DateTime?
  verifiedAt  DateTime?

  @@index([deviceId, status])
  @@index([batchId])
}

/// Configuration history: only written for verified changes or on-device changes.
model ConfigChange {
  id        String        @id @default(cuid())
  familyId  String
  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  child     Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  key       ProtectionKey
  title     String
  actor     String
  fromValue String?
  toValue   String?
  createdAt DateTime      @default(now())

  @@index([familyId, createdAt])
  @@index([childId])
}

model CheckRun {
  id          String         @id @default(cuid())
  familyId    String
  family      Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  status      CheckRunStatus @default(RUNNING)
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  results     CheckRunResult[]

  @@index([familyId])
}

model CheckRunResult {
  id         String   @id @default(cuid())
  runId      String
  run        CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reachable  Boolean?
  issues     Int?
  reportedAt DateTime?

  @@unique([runId, deviceId])
}

// ---------- Alerts ----------

model Alert {
  id         String        @id @default(cuid())
  familyId   String
  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId    String?
  child      Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId   String?
  severity   AlertSeverity
  category   AlertCategory
  icon       String
  title      String
  body       String
  subject    String
  fromValue  String?
  toValue    String?
  /// what resolves it, e.g. "BEDTIME:<deviceId>"
  resolveKey String?
  resolvedAt DateTime?
  /// when parents were emailed about it (set once, even if nobody wanted email)
  notifiedAt DateTime?
  createdAt  DateTime      @default(now())

  reads AlertRead[]

  @@index([familyId, createdAt])
  @@index([familyId, resolveKey])
  // the maintenance job's "not emailed yet" queue
  @@index([notifiedAt, createdAt])
}

model AlertRead {
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt  DateTime @default(now())

  @@id([alertId, userId])
  @@index([userId])
}
