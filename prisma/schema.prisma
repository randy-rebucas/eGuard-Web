generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  FAMILY_ADMIN
  PARENT
}

enum Platform {
  ANDROID
  IOS
  /// The eGuard desktop agent (eguard-desktop) on a Windows PC or a Mac
  WINDOWS
  MACOS
}

enum DeviceKind {
  PHONE
  TABLET
  COMPUTER
}

/// Protection keys double as the 10 Configuration Health checks.
enum ProtectionKey {
  SCREEN_TIME
  BEDTIME
  APP_RESTRICTIONS
  APP_APPROVAL
  CONTENT
  WEB
  DOWNLOADS
  LOCATION
  NOTIFICATIONS
  UNINSTALL_PROTECTION
}

enum CheckStatus {
  PASS
  WARNING
  ACTION_REQUIRED
  UNSUPPORTED
  NOT_CONFIGURED
}

enum RequestMode {
  APPLY   // eGuard applies it on the device directly
  GUIDED  // parent performs steps on the device, eGuard verifies
}

enum RequestStatus {
  PENDING          // waiting for the device to pick it up
  AWAITING_PARENT  // guided setup: waiting for parent to finish steps
  DELIVERED        // device received it / verification requested
  VERIFIED         // device reported config matching the request
  FAILED           // device reported a mismatch or an error
  CANCELLED
}

enum AlertSeverity {
  INFO
  ATTENTION
  ACTION_REQUIRED
  CRITICAL
}

enum AlertCategory {
  PROTECTION
  DEVICES
  APPS
  SCREEN_TIME
  LOCATION
  SYSTEM
}

enum AppApproval {
  ALLOWED
  ALWAYS_ALLOWED
  FILTERED
  BLOCKED
  PENDING
}

enum PairingKind {
  DEVICE   // the child app on a phone or tablet (/api/device/v1/pair)
  BROWSER  // the eGuard browser extension (/api/browser/v1/pair)
}

enum CheckRunStatus {
  RUNNING
  COMPLETED
}

enum OrgKind {
  SCHOOL
  COMMUNITY
  BUSINESS
}

enum OrgRole {
  OWNER
  ADMIN
}

// ---------- Account ----------

model Family {
  id            String   @id @default(cuid())
  name          String
  timezone      String   @default("Asia/Manila")
  plan          String   @default("Free")
  deviceLimit   Int      @default(2)
  renewsAt      DateTime?
  /// PayMongo customer (cus_…) that web subscriptions bill
  paymongoCustomerId String? @unique
  // privacy & notification settings
  keepLocationHistory Boolean @default(false)
  shareAnalytics      Boolean @default(false)
  retentionDays       Int     @default(90)
  /// when the last weekly summary went out (claimed once per family, for every parent who wants it)
  digestSentAt        DateTime?
  createdAt     DateTime @default(now())

  users        User[]
  children     Child[]
  devices      Device[]
  alerts       Alert[]
  changes      ConfigChange[]
  pairingCodes PairingCode[]
  browsers     BrowserInstallation[]
  checkRuns    CheckRun[]
  auditLogs    AuditLog[]
  purchases    StorePurchase[]
  supportTickets SupportTicket[]
  orgMemberships OrgMembership[]
  vouchers     Voucher[]
  places       Place[]
}

model User {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  email        String   @unique
  /// Set when the parent opens the link we emailed, or signs in with a provider-verified email.
  /// Cleared when the email changes. Unverified parents can't pair a child's device.
  emailVerifiedAt DateTime?
  name         String
  passwordHash String
  /// false for Apple/Google sign-ups until they set a password (through "Forgot password")
  passwordSet  Boolean  @default(true)
  role         Role     @default(PARENT)
  // notification preferences
  notifyPush     Boolean @default(true)
  notifyEmail    Boolean @default(true)
  notifyApproval Boolean @default(true)
  weeklySummary  Boolean @default(true)
  /// Product-update emails the eGuard team sends (console › Email). Off: only service notices reach this parent
  productUpdates Boolean @default(true)
  /// Two-step verification is on: signing in needs a code from the authenticator app (or a recovery code)
  twoFactor      Boolean @default(false)
  /// The authenticator secret, AES-GCM encrypted (lib/two-factor). Set while setting up, before `twoFactor` turns on.
  totpSecret     String?
  /// The last 30-second step a code was accepted for, so one code can't be used twice
  totpLastStep   Int?
  passwordChangedAt DateTime @default(now())
  /// Set when the parent closes the first-run intro on the web app (taking the quick tour or not). Null: show it.
  introSeenAt  DateTime?
  /// When a family admin closed the dashboard's "Turn on two-step verification" prompt; it comes back after 90 days
  twoFactorPromptClosedAt DateTime?
  createdAt    DateTime @default(now())

  sessions Session[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
  readAlerts AlertRead[]
  identities OAuthIdentity[]
  pushTokens PushToken[]
  recoveryCodes RecoveryCode[]
  loginChallenges LoginChallenge[]
  supportTickets SupportTicket[]
  orgRoles   OrgMember[]
  orgApiKeys OrgApiKey[]
  orgInvitesSent OrgInvite[]
  broadcastDeliveries BroadcastDelivery[]
  knownDevices KnownDevice[]
  carePreference   ParentCarePreference?
  careEnrollments  ParentCareEnrollment[]
  careJobs         ParentCareJob[]
  careMessages     ParentCareMessage[]
  careEvents       ParentCareEvent[]
  careActivities   ParentCareActivity[]
  carePlans        ParentCarePlan[]
  careSuppressions ParentCareSuppression[]

  @@index([familyId])
}

/// A sign-up waiting for the 6-digit code emailed to it (lib/signup). The family and its admin are only created once
/// the code checks out, so the form answers the same whether or not the email already has an account. `codeHash` is
/// null when it does: no code works, and the email sent says to sign in instead. `tokenHash` is the SHA-256 of the
/// ticket the browser (a cookie) or the app holds, so the code only works where the form was filled in.
model SignupRequest {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  email        String
  name         String
  familyName   String
  passwordHash String
  codeHash     String?
  attempts     Int      @default(0)
  sends        Int      @default(1)
  sentAt       DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
}

/// A browser or app install a parent has signed in from (lib/sign-in-notice), so a sign-in from a new one is emailed.
/// `key` is the SHA-256 of the browser's device cookie or the app's install id.
model KnownDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  label      String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, key])
}

/// A single-use "verify your email" link. Only the SHA-256 of the token is stored; `email` is the
/// address it was sent to, so a link stops working if the parent changes their email meanwhile.
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A single-use "reset your password" link (SHA-256 of the token only). Valid for an hour.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// One-time codes for signing in without the authenticator app. Only the SHA-256 is stored.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// The password (or reset link) was right, and the second step is still to come. Short-lived; only the token's
/// SHA-256 is stored. A session is issued only once a code checks out.
model LoginChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Fixed-window counters for rate limits, shared by every server instance.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Sign in with Apple / Google. `subject` is the provider's stable user id.
model OAuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

/// APNs/FCM tokens for the parent's own phone (delivery provider not wired yet).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  Platform
  /// The sign-in that registered it: signing that session out (here or from another device) stops its alerts.
  /// Null for tokens registered before this was recorded.
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

/// A plan purchase, verified with the store or payment provider. One purchase token belongs to one family.
model StorePurchase {
  id            String   @id @default(cuid())
  familyId      String
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  store         String   // "GOOGLE_PLAY" | "PAYMONGO"
  productId     String
  /// Google Play purchase token; PayMongo checkout session id (cs_…) or subscription id (subs_…)
  purchaseToken String   @unique
  /// store state, e.g. SUBSCRIPTION_STATE_ACTIVE or PayMongo's active; REPLACED when a newer purchase supersedes it
  state         String
  autoRenewing  Boolean  @default(false)
  /// end of the paid period
  expiresAt     DateTime?
  /// PayMongo payment (pay_…) of a prepaid pass, to match refunds
  paymentId     String?
  /// when the "your pass ends soon" reminder went out
  remindedAt    DateTime?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([familyId])
  @@index([paymentId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category  String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  /// A browser's cookie session (lib/auth createSession), which also ends after 14 days unused. App sessions don't:
  /// their push alerts must keep arriving while the parent doesn't open the app.
  web        Boolean  @default(false)
  pushTokens PushToken[]

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
}

// ---------- Organizations (docs/organizations.md) ----------

/**
 * A school, community group or business that helps families: they join it with its code, and it can buy
 * sponsor codes that pay for families' plans. It never sees a family's data, only counts.
 */
model Organization {
  id        String   @id @default(cuid())
  name      String
  kind      OrgKind
  /// XXXXXXXX (shown as XXXX-XXXX); replacing it stops the old one working
  joinCode  String   @unique
  createdAt DateTime @default(now())
  /// When admins were last sent the daily activity email (covers OrgEvents up to this time)
  digestSentAt DateTime?

  members     OrgMember[]
  memberships OrgMembership[]
  batches     VoucherBatch[]
  events      OrgEvent[]
  apiKeys     OrgApiKey[]
  invites     OrgInvite[]
}

/// An owner's invitation to help manage an organization. The person becomes an admin only when they accept it in
/// Settings › Organizations. Kept whether or not the email has an eGuard account, so the owner can't tell which.
model OrgInvite {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Lowercased; matched against the signed-in person's email when they accept
  email       String
  invitedById String
  invitedBy   User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  expiresAt   DateTime

  @@unique([orgId, email])
  @@index([email])
}

/// A key for the organization API (/api/org/v1, docs/organization-api.md). Only its hash is stored.
model OrgApiKey {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  /// The start of the key (egk_ + 8 characters), shown so admins can tell keys apart
  prefix      String
  tokenHash   String       @unique
  /// READ, or WRITE (read, and cancel codes)
  access      String       @default("READ")
  /// Works while this admin manages the organization and their family's plan includes API access
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([orgId])
}

/// Something that happened in an organization, for the admins' daily email. Deliberately has no family:
/// the email says how many, never who. Kept 30 days.
model OrgEvent {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// JOINED | LEFT | REDEEMED | CANCELLED
  kind      String
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
}

/// An eGuard user who manages an organization. They stay in their own family; this only adds a role.
model OrgMember {
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgRole      @default(ADMIN)
  createdAt DateTime     @default(now())

  @@id([orgId, userId])
  @@index([userId])
}

/// A family that joined an organization with its join code. Only the family can create or remove it.
model OrgMembership {
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  familyId String
  family   Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  joinedAt DateTime     @default(now())

  @@id([orgId, familyId])
  @@index([familyId])
}

/// One purchase of sponsor codes (one PayMongo checkout). Codes are created when the payment is confirmed.
model VoucherBatch {
  /// Also the checkout's reference number
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// PLUS | PRO
  plan          String
  /// 1, 3, 6 or 12
  months        Int
  quantity      Int
  /// Total charged, centavos
  amount        Int
  /// PayMongo checkout session (cs_…)
  purchaseToken String   @unique
  /// PENDING | PAID | EXPIRED | VOIDED
  state         String   @default("PENDING")
  /// PayMongo payment (pay_…), to match refunds
  paymentId     String?
  paidAt        DateTime?
  /// User id of the admin who bought it
  createdBy     String
  /// When admins were told its unused codes' redeem-by date is near
  expiryRemindedAt DateTime?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  vouchers Voucher[]

  @@index([orgId, createdAt])
  @@index([paymentId])
}

/// A sponsor code: one family redeems it once for the batch's plan and months.
model Voucher {
  id         String       @id @default(cuid())
  batchId    String
  batch      VoucherBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// XXXXXXXXXXXX (shown as XXXX-XXXX-XXXX). Stored so admins can view and hand out their codes
  code       String       @unique
  /// Redeem by
  expiresAt  DateTime
  redeemedAt DateTime?
  /// The family that redeemed it. For support and refunds only: never shown to the organization
  familyId   String?
  family     Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)
  /// Cancelled by an admin, or by a refund of the batch
  revokedAt  DateTime?

  @@index([batchId])
  @@index([familyId])
}

// ---------- Children & devices ----------

model Child {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name       String
  birthYear  Int
  hue        Int      @default(205)
  dailyLimitMinutes   Int @default(180)
  weekendLimitMinutes Int @default(240)
  /// Extra time a parent gave: until then, the child's devices don't pause apps for limits or bedtime
  extraTimeUntil DateTime?
  createdAt  DateTime @default(now())

  devices    Device[]
  policies   ChildPolicy[]
  usage      ScreenTimeDaily[]
  appUsage   AppUsageDaily[]
  apps       ChildApp[]
  categoryLimits ChildCategoryLimit[]
  changes    ConfigChange[]
  requests   ConfigRequest[]
  alerts     Alert[]
  browsers   BrowserInstallation[]
  browserPolicy BrowserPolicy?
  accessRequests BrowserAccessRequest[]
  photo      ChildPhoto?
  visits     LocationVisit[]

  @@index([familyId])
}

/// Profile photo, kept out of Child so ordinary queries don't load the bytes.
model ChildPhoto {
  childId     String   @id
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
}

/// Desired configuration per child and protection (what the parent asked for).
model ChildPolicy {
  id        String        @id @default(cuid())
  childId   String
  child     Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  key       ProtectionKey
  config    Json
  updatedAt DateTime      @updatedAt

  @@unique([childId, key])
}

model Device {
  id          String     @id @default(cuid())
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId     String
  child       Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  name        String
  model       String
  kind        DeviceKind @default(PHONE)
  platform    Platform
  osVersion   String
  isPrimary   Boolean    @default(false)
  battery     Int?
  appVersion  String?
  tokenHash   String?    @unique
  lastSeenAt  DateTime?
  checkRequestedAt DateTime?
  /// FCM registration token the child app sends on /sync, so a change can wake it (silent push) instead of
  /// waiting for its next poll. Null until the app sends one, or once FCM reports it gone.
  pushToken   String?
  /// Dev-only: device is driven by the built-in simulator
  simulated   Boolean    @default(false)
  simulatedOnline Boolean @default(true)
  /// Computers only: the secret behind the parent's offline removal codes (lib/device-removal). Sent to the agent once,
  /// at pairing, and shown to nobody.
  removalSecret         String?
  /// Computers only: a parent removed it. The agent can't be uninstalled on the PC itself, so the device stays until
  /// the agent picks up eGuard's signed uninstall command on sync and confirms (UNINSTALL_ACK), or a parent finishes
  /// the removal without waiting.
  removalRequestedAt    DateTime?
  removalRequestedBy    String?
  /// Whether to delete what it recorded once the removal finishes (the parent's choice when removing)
  removalDeletesHistory Boolean    @default(false)
  /// Computers only: the Windows accounts on it and whether eGuard applies the child's rules in each, as the agent last
  /// reported (`/report` `accounts`: [{ name, enforced }]). The parent picks them when pairing; the rest (a parent's
  /// own account on a family PC) aren't limited or counted. Null until the agent reports them.
  accounts              Json?
  createdAt   DateTime   @default(now())

  protections DeviceProtection[]
  requests    ConfigRequest[]
  location    DeviceLocation?
  usage       ScreenTimeDaily[]
  appUsage    AppUsageDaily[]
  checkResults CheckRunResult[]
  visits      LocationVisit[]
  /// Computers: the browsers on it, connected through its agent (lib/browser-link). They don't take a device slot.
  browsers    BrowserInstallation[]

  @@index([familyId])
  @@index([childId])
}

/// Verified state per device and protection (what the device reported).
model DeviceProtection {
  id             String        @id @default(cuid())
  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key            ProtectionKey
  status         CheckStatus
  reported       Json?
  message        String?
  lastVerifiedAt DateTime?

  @@unique([deviceId, key])
}

model DeviceLocation {
  deviceId   String   @id
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sharing    Boolean  @default(true)
  lat        Float?
  lng        Float?
  accuracyM  Float?
  placeLabel String?
  /// the saved place this fix fell inside; placeLabel is then that place's name
  placeId    String?
  place      Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  /// when the coordinates were last reported (not when sharing state changed)
  locatedAt  DateTime?
  updatedAt  DateTime @updatedAt
}

/// A place the parents named (Home, School). A fix within `radiusM` of it is labelled with its name.
model Place {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  lat       Float
  lng       Float
  radiusM   Int      @default(150)
  /// Alert the parents when a child arrives here / leaves (location.placeNotices)
  notifyArrive Boolean @default(false)
  notifyLeave  Boolean @default(false)
  createdAt DateTime @default(now())

  visits    LocationVisit[]
  locations DeviceLocation[]

  @@index([familyId])
}

/// Places a device stayed at. Only written when the family turns on location history.
/// The device is null once it's removed: the child's history stays until retention or the child is deleted.
model LocationVisit {
  id         String   @id @default(cuid())
  deviceId   String?
  device     Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  placeLabel String?
  /// the saved place it was at; placeLabel is then that place's name
  placeId    String?
  place      Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  arrivedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([childId, arrivedAt])
  @@index([deviceId, arrivedAt])
}

model PairingCode {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  code      String   @unique
  kind      PairingKind @default(DEVICE)
  /// BROWSER codes: the computer the parent is adding, e.g. "Mia's MacBook"
  deviceLabel String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([childId])
}

/**
 * The eGuard browser extension in one browser on a child's computer. Counts toward the plan's device limit.
 * Credentials: a refresh token that rotates on every use and a 15-minute access token, both stored as SHA-256.
 * The previous refresh token is kept so a replayed (copied) one can be detected.
 */
model BrowserInstallation {
  id                   String    @id @default(cuid())
  familyId             String
  family               Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId              String
  child                Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// Entered by the parent with the pairing code; nothing is read from the machine
  deviceLabel          String
  /// The paired computer this browser is on, proven by the agent's browser link (lib/browser-link). Such a browser is
  /// part of that computer: it takes no device slot, moves with it and is removed with it. Null for any other browser.
  deviceId             String?
  device               Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  browser              String
  browserVersion       String?
  extensionVersion     String
  /// runtime.getPlatformInfo().os: win, mac, linux, cros, …
  platform             String
  refreshTokenHash     String?   @unique
  prevRefreshTokenHash String?   @unique
  refreshRotatedAt     DateTime?
  accessTokenHash      String?   @unique
  accessTokenExpiresAt DateTime?
  lastSeenAt           DateTime?
  /// Set when eGuard disconnected it for security (a copied refresh token was used)
  revokedAt            DateTime?
  /// From the latest health report: the extension's own answer (PROTECTED, NEEDS_ATTENTION, …), null until the first
  protectionState      String?
  /// The policy version the browser says it is enforcing
  appliedPolicyVersion Int?
  lastHealthAt         DateTime?
  createdAt            DateTime  @default(now())

  healthChecks BrowserHealthCheck[]
  dailyEvents  BrowserEventDaily[]

  @@index([familyId])
  @@index([childId])
  @@index([deviceId])
}

/// One health report from the extension: its self-checks and the policy version it enforces.
model BrowserHealthCheck {
  id             String              @id @default(cuid())
  installationId String
  installation   BrowserInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  policyVersion  Int?
  /// ProtectionState the extension showed
  state          String
  /// [{ id, status }]
  checks         Json
  /// Passing checks, out of those that apply (UNSUPPORTED and NOT_CONFIGURED don't count)
  score          Int
  total          Int
  createdAt      DateTime            @default(now())

  @@index([installationId, createdAt])
}

/// Aggregated only: how many pages of one kind were blocked in a browser on a day. Never a URL or domain.
model BrowserEventDaily {
  installationId String
  installation   BrowserInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  /// The day in the family's time zone
  date           DateTime            @db.Date
  /// A WebCategory, or BLOCKED_SITE / UNKNOWN_SITE / FOCUS_HOURS
  category       String
  blockedCount   Int

  @@id([installationId, date, category])
}

/**
 * What the eGuard browser extension enforces for one child, shared by all of that child's browsers.
 * `version` goes up on every change; the extension refuses to move backwards. Created with age-based
 * defaults the first time it's needed.
 */
model BrowserPolicy {
  id                 String   @id @default(cuid())
  childId            String   @unique
  child              Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  version            Int      @default(1)
  safeBrowsing       Boolean  @default(true)
  safeSearch         Boolean  @default(true)
  /// YouTube Restricted Mode: OFF | MODERATE | STRICT
  youtubeRestrict    String   @default("MODERATE")
  blockedCategories  String[]
  blockedDomains     String[]
  allowedDomains     String[]
  /// ALLOW | WARN | BLOCK
  unknownSitesPolicy String   @default("ALLOW")
  /// { enabled, startTime "HH:MM", endTime "HH:MM" } in the family's timezone, or null
  schedule           Json?
  /// Sites a parent approved for a while: [{ domain, until (ISO) }]. Expired entries are pruned on the next change.
  temporaryAllows    Json     @default("[]")
  updatedBy          String
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  versions BrowserPolicyVersion[]
}

/// A child asking, from the browser's block page, to open a blocked site. The parent approves or denies.
model BrowserAccessRequest {
  id             String    @id @default(cuid())
  familyId       String
  childId        String
  child          Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  installationId String?
  domain         String
  reason         String?
  /// PENDING | APPROVED | DENIED
  status         String    @default("PENDING")
  /// 15M | 1H | TODAY | ALWAYS, when approved
  duration       String?
  expiresAt      DateTime?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([childId, status])
  @@index([familyId, createdAt])
}

/// Immutable snapshot of every version: what was in force when, and who changed it.
model BrowserPolicyVersion {
  id        String        @id @default(cuid())
  policyId  String
  policy    BrowserPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  createdBy String
  createdAt DateTime      @default(now())

  @@unique([policyId, version])
}

// ---------- Activity ----------

/// The device is null once it's removed: the child's screen time stays in reports until retention.
model ScreenTimeDaily {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId String?
  device   Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  date     DateTime @db.Date
  minutes  Int
  /// 24 per-hour totals in the family's timezone, when the device sends them
  hourly   Int[]    @default([])

  @@unique([deviceId, date])
  @@index([childId, date])
}

/// Per device, so a child's phone and tablet don't overwrite each other; sum across devices to show a child's total.
/// The device is null once it's removed, as for ScreenTimeDaily.
model AppUsageDaily {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId String?
  device   Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  date     DateTime @db.Date
  app      String
  minutes  Int

  @@unique([deviceId, date, app])
  @@index([childId, date])
}

model ChildApp {
  id         String      @id @default(cuid())
  childId    String
  child      Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  name       String
  approval   AppApproval @default(ALLOWED)
  dailyLimitMinutes Int?
  /// The parent's choice; null means eGuard's guess from the name (lib/app-categories.categoryOf)
  category   AppCategory?
  installedAt DateTime   @default(now())
  /// How the agent found it on a computer: CATALOG (a known game), LAUNCHER (Steam, Epic…) or UNKNOWN_PUBLISHER.
  /// Null for phone apps.
  source            AppSource?
  identifiers       AppIdentifier[]

  @@unique([childId, name])
}

enum AppSource {
  CATALOG
  LAUNCHER
  UNKNOWN_PUBLISHER
}

/// A stable id for an app on one platform ("steam:730", "exe:<signer>|<product>"), so the same app reported under
/// two names ("Counter-Strike 2" from Steam's manifest, "cs2.exe" from a process) is one row on the child's list.
model AppIdentifier {
  id         String            @id @default(cuid())
  childAppId String
  childApp   ChildApp          @relation(fields: [childAppId], references: [id], onDelete: Cascade)
  /// Copied from the app, so an id is unique per child
  childId    String
  platform   Platform
  kind       AppIdentifierKind
  value      String

  @@unique([childId, platform, kind, value])
  @@index([childAppId])
}

enum AppIdentifierKind {
  STEAM
  EPIC
  RIOT
  BATTLENET
  EA
  UBISOFT
  GOG
  MSSTORE
  EXE
  PACKAGE
  BUNDLE
}

/// What the desktop agent knows before it scans: games worth reporting (trending or not), and publishers it can skip
/// (drivers, office suites, runtimes). Served signed and versioned on GET /api/device/v1/catalog; seeded by
/// scripts/seed-desktop-catalog.ts.
model DesktopCatalogEntry {
  id          String             @id @default(cuid())
  kind        DesktopCatalogKind
  /// What to match: a launcher id ("steam:730"), an exe file name ("cs2.exe", lowercase), an Authenticode signer
  /// ("Roblox Corporation") or a product name
  matchType   DesktopMatchType
  match       String
  /// Games only: the name the parent sees
  displayName String?
  category    AppCategory?
  /// Shown to parents as "a popular game"
  trending    Boolean            @default(false)
  updatedAt   DateTime           @updatedAt

  @@unique([kind, matchType, match])
  @@index([updatedAt])
}

enum DesktopCatalogKind {
  GAME
  TRUSTED_PUBLISHER
}

enum DesktopMatchType {
  LAUNCHER_ID
  EXE_NAME
  SIGNER
  PRODUCT_NAME
}

enum AppCategory {
  GAMES
  SOCIAL
  VIDEO
  MESSAGING
  EDUCATION
  CREATIVITY
  BROWSERS
  OTHER
}

/// A daily limit for all of a child's apps in one category together ("Gaming time"), sent to devices on sync
model ChildCategoryLimit {
  id                String      @id @default(cuid())
  childId           String
  child             Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  category          AppCategory
  dailyLimitMinutes Int
  updatedAt         DateTime    @updatedAt

  @@unique([childId, category])
}

// ---------- Configuration workflow ----------

model ConfigRequest {
  id          String        @id @default(cuid())
  batchId     String
  childId     String
  child       Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId    String
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key         ProtectionKey
  mode        RequestMode
  desired     Json
  previous    Json?
  status      RequestStatus @default(PENDING)
  failureReason String?
  createdBy   String
  createdAt   DateTime      @default(now())
  deliveredAt DateTime?
  verifiedAt  DateTime?

  @@index([deviceId, status])
  @@index([batchId])
}

/// Configuration history: only written for verified changes or on-device changes.
model ConfigChange {
  id        String        @id @default(cuid())
  familyId  String
  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  child     Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  key       ProtectionKey
  title     String
  actor     String
  fromValue String?
  toValue   String?
  createdAt DateTime      @default(now())

  @@index([familyId, createdAt])
  @@index([childId])
}

model CheckRun {
  id          String         @id @default(cuid())
  familyId    String
  family      Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  status      CheckRunStatus @default(RUNNING)
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  results     CheckRunResult[]

  @@index([familyId])
}

model CheckRunResult {
  id         String   @id @default(cuid())
  runId      String
  run        CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reachable  Boolean?
  issues     Int?
  reportedAt DateTime?

  @@unique([runId, deviceId])
}

// ---------- Alerts ----------

model Alert {
  id         String        @id @default(cuid())
  familyId   String
  family     Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId    String?
  child      Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId   String?
  severity   AlertSeverity
  category   AlertCategory
  icon       String
  title      String
  body       String
  subject    String
  fromValue  String?
  toValue    String?
  /// what resolves it, e.g. "BEDTIME:<deviceId>"
  resolveKey String?
  resolvedAt DateTime?
  /// when parents were emailed about it (set once, even if nobody wanted email)
  notifiedAt DateTime?
  createdAt  DateTime      @default(now())

  reads AlertRead[]

  @@index([familyId, createdAt])
  @@index([familyId, resolveKey])
  // the maintenance job's "not emailed yet" queue
  @@index([notifiedAt, createdAt])
}

model AlertRead {
  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt  DateTime @default(now())

  @@id([alertId, userId])
  @@index([userId])
}

// ---------- Staff console (console.eguard.family, docs/console.md) ----------

/**
 * An eGuard staff member who signs in to the console. Not a family member: staff have no family, children or
 * devices, and a parent's account never opens the console. Created and reset with scripts/create-staff.ts only.
 */
model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  /// The authenticator secret, AES-GCM encrypted (lib/totp sealSecret). Always set: the code is required
  totpSecret   String
  /// The last 30-second step a code was accepted for, so one code can't be used twice
  totpLastStep Int?
  /// false: can't sign in (their sessions are ended too)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  sessions   StaffSession[]
  auditLogs  StaffAuditLog[]
  broadcasts Broadcast[]
}

/// A signed-in console browser. Only the SHA-256 of the cookie's token is stored.
model StaffSession {
  id         String    @id @default(cuid())
  staffId    String
  staff      StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime

  @@index([staffId])
}

/// What staff did and looked at in the console: every change, and every account they opened.
model StaffAuditLog {
  id        String    @id @default(cuid())
  staffId   String
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// e.g. family.view, ticket.status, staff.login
  action    String
  /// What it was about, as "kind:id" (family:clx…, ticket:clx…)
  target    String?
  detail    String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([staffId, createdAt])
}

/// An email the eGuard team sends to many parents at once (console › Email, docs/console.md §8)
model Broadcast {
  id          String    @id @default(cuid())
  /// UPDATE: product news, only to parents with productUpdates on, with an unsubscribe link.
  /// SERVICE: account, legal or security notices every verified parent gets.
  kind        String    @default("UPDATE")
  subject     String
  /// Plain text; a blank line starts a new paragraph, and links are made clickable
  body        String
  /// Plan names (Family.plan) it goes to; empty: every plan
  plans       String[]
  /// DRAFT → SCHEDULED → SENDING → SENT, or CANCELLED from any of the first three
  status      String    @default("DRAFT")
  /// When the maintenance job starts sending it (now, for "Send now")
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  /// PARENTS: verified parents (kind and plans apply). NEWSLETTER or IOS_LAUNCH: confirmed Subscribers on that
  /// list; always a product update, plans ignored (lib/broadcasts BROADCAST_AUDIENCES)
  audience    String    @default("PARENTS")
  /// How many parents (or subscribers) the recipient list held when sending started
  recipients  Int       @default(0)
  createdById String
  createdBy   StaffUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deliveries BroadcastDelivery[]

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@index([createdById])
}

/// One parent on a broadcast's recipient list, taken when sending starts, so a run that stops halfway resumes
/// where it left off and nobody gets it twice
model BroadcastDelivery {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// For a NEWSLETTER or IOS_LAUNCH broadcast; null once they unsubscribe (the row is deleted)
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  email       String
  /// PENDING → SENDING → SENT or FAILED; SKIPPED when cancelled, unsubscribed or gone before their turn
  status      String    @default("PENDING")
  error       String?
  /// The email's unsubscribe link (product updates only); it can do nothing else
  token       String    @unique
  sentAt      DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([broadcastId, email])
  @@index([broadcastId, status])
  @@index([userId])
  @@index([subscriberId])
}

/// Someone who asked for email from the public site: eGuard news, or a note when the iPhone app is out. Not tied to
/// an account. Double opt-in: nothing is sent until they press the link in the confirmation email. Unconfirmed rows
/// are deleted after a week, and unsubscribing deletes the row (lib/subscribers).
model Subscriber {
  id               String    @id @default(cuid())
  /// Lowercased
  email            String    @unique
  /// "NEWSLETTER", "IOS_LAUNCH"
  lists            String[]
  /// Where they last signed up ("footer", "iphone"), for counts only
  source           String
  /// sha256 of the confirmation link's token; null once confirmed
  confirmTokenHash String?   @unique
  confirmSentAt    DateTime
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deliveries BroadcastDelivery[]

  @@index([confirmedAt])
  @@index([createdAt])
}

// ---------- Parent care (docs/features/parent-care.md) ----------

/**
 * A parent's choices for tips, reminders and check-ins from eGuard (Settings › Notifications › Tips and reminders).
 * Separate from alert preferences: nothing here can hold back a safety alert. Push and email need explicit consent
 * (`pushConsentAt`, `emailConsentAt`), recorded when the parent turns them on; in-app is on by default.
 */
model ParentCarePreference {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Master switch for every optional automation
  enabled          Boolean   @default(true)
  /// Null: the family's time zone
  timezone         String?
  /// "en" or "fil" (lib/parent-care/templates SUPPORTED_LANGUAGES)
  language         String    @default("en")
  inApp            Boolean   @default(true)
  push             Boolean   @default(false)
  email            Boolean   @default(false)
  pushConsentAt    DateTime?
  emailConsentAt   DateTime?
  /// Per automation
  briefings        Boolean   @default(true)
  followUps        Boolean   @default(true)
  weeklyPlan       Boolean   @default(true)
  checkIns         Boolean   @default(true)
  monthlyReport    Boolean   @default(true)
  /// Days of the week for briefings, 0 = Sunday
  briefingDays     Int[]     @default([1, 3, 5])
  /// Local minutes after midnight messages are sent at (default 7:30 PM)
  deliveryMinute   Int       @default(1170)
  /// Quiet hours for push and email, local minutes after midnight; equal: none
  quietStart       Int       @default(1260)
  quietEnd         Int       @default(420)
  /// TREATMENT or HOLDOUT, fixed when the row is made: holdout parents get no proactive messages, for measuring
  cohort           String    @default("TREATMENT")
  /// The last qualifying action (lib/parent-care/events QUALIFYING_TYPES): passive opens never count
  lastQualifyingAt DateTime  @default(now())
  /// When the scheduler last planned this parent's time-based messages
  plannedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([lastQualifyingAt])
  @@index([plannedAt])
}

/**
 * An automation's live state. Steps and rules live in code (lib/parent-care/definitions), versioned; staff pause it here.
 */
model ParentCareAutomation {
  key         String   @id
  name        String
  description String
  /// EVENT or SCHEDULE
  triggerType String
  enabled     Boolean  @default(true)
  /// The code definition's version last synced
  version     Int      @default(1)
  /// Snapshot of the definition (steps, caps, channels), for the console
  config      Json
  templateKey String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments ParentCareEnrollment[]
  jobs        ParentCareJob[]
}

/**
 * A parent going through a multi-step automation (a reactivation sequence).
 */
model ParentCareEnrollment {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationKey String
  automation    ParentCareAutomation @relation(fields: [automationKey], references: [key], onDelete: Cascade)
  /// What it's about, e.g. the start of the inactivity period
  subjectKey    String
  /// ACTIVE, COMPLETED, EXITED; HOLDOUT: would have been enrolled (measured, never messaged)
  status        String               @default("ACTIVE")
  version       Int                  @default(1)
  step          Int                  @default(0)
  nextAt        DateTime?
  startedAt     DateTime             @default(now())
  completedAt   DateTime?
  exitReason    String?
  updatedAt     DateTime             @updatedAt

  jobs ParentCareJob[]

  @@unique([userId, automationKey, subjectKey])
  @@index([automationKey, status])
}

/**
 * One scheduled message step. `idempotencyKey` makes scheduling the same step twice a no-op.
 */
model ParentCareJob {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationKey  String
  automation     ParentCareAutomation  @relation(fields: [automationKey], references: [key], onDelete: Cascade)
  enrollmentId   String?
  enrollment     ParentCareEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step           Int                   @default(0)
  /// Minimal: an activity key, a plan week, a report month. Never message text or child details.
  payload        Json                  @default("{}")
  runAt          DateTime
  /// PENDING → RUNNING → DONE | SKIPPED | CANCELLED; RUNNING → PENDING (retry) or DEAD (gave up)
  status         String                @default("PENDING")
  attempts       Int                   @default(0)
  idempotencyKey String                @unique
  lockedAt       DateTime?
  /// Why it was skipped or failed: an eligibility reason or error code, never a stack trace
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  messages ParentCareMessage[]

  @@index([status, runAt])
  @@index([userId, status])
  @@index([automationKey, status])
  @@index([enrollmentId])
}

/**
 * One message sent (or attempted) on one channel. Its text isn't stored: it's rendered from `templateKey` and
 * `contentKey` when shown. `dedupeKey` (the job's key) allows one message per job, whatever the retries.
 */
model ParentCareMessage {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  automationKey   String
  jobId           String?
  job             ParentCareJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  dedupeKey       String         @unique
  /// PUSH, EMAIL, IN_APP
  channel         String
  templateKey     String
  templateVersion Int
  language        String
  /// The tip, activity, plan or report it carried, so the same one isn't sent again
  contentKey      String?
  /// What the template was given: ids only (a tip key, activity keys, a month), never text or child details
  params          Json           @default("{}")
  /// Where opening it goes: an app path
  link            String
  /// Counts toward the contact limits
  proactive       Boolean        @default(true)
  /// SENDING → ACCEPTED (the provider took it) | DELIVERED (in-app: shown) | FAILED; UNCERTAIN: a send was
  /// interrupted, and isn't retried so it can't arrive twice
  status          String         @default("SENDING")
  providerRef     String?
  /// An error code, never a provider's full response
  error           String?
  /// Click tracking and one-click opt-out in emails
  token           String         @unique
  sentAt          DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([userId, channel, createdAt])
  @@index([automationKey, createdAt])
  @@index([status, createdAt])
}

/**
 * Lifecycle and engagement events (lib/parent-care/events EVENT_TYPES). `eventId` is stable, so a repeat is dropped.
 */
model ParentCareEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  type       String
  occurredAt DateTime
  /// Minimal: an automation key, a channel, an activity key. Never child details or message text
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId, type, occurredAt])
  @@index([type, occurredAt])
  @@index([familyId, occurredAt])
}

/**
 * A parent's progress on a safety activity from the catalog (lib/parent-care/content ACTIVITIES).
 */
model ParentCareActivity {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityKey String
  /// STARTED, COMPLETED, DISMISSED ("not for us")
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, activityKey])
  @@index([userId, status])
  @@index([status, completedAt])
}

/**
 * This week's one or two activities for a parent. `week`: the local Monday, YYYY-MM-DD.
 */
model ParentCarePlan {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  week         String
  activityKeys String[]
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?
  openedAt     DateTime?

  @@unique([userId, week])
}

/**
 * A contact restriction: an opt-out (no `until`), or a cooldown, temporary suppression or bounce (with `until`).
 * `scope`: ALL, an automation key, or a channel (CHANNEL:EMAIL, CHANNEL:PUSH, CHANNEL:IN_APP).
 */
model ParentCareSuppression {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  /// OPT_OUT, COOLDOWN, BOUNCE, ADMIN
  reason    String
  until     DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, scope, reason])
  @@index([scope])
}
